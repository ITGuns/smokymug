# Copy to .env.local and fill in.

# Supabase Postgres. The app uses the transaction pooler (port 6543, IPv4-friendly, works on Vercel);
# migrations/seeding use the session pooler or direct connection (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string used to sign admin session cookies (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin login (created by `npm run db:seed`)
ADMIN_EMAIL=owner@smokymug.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Owner

# Public site URL, used for SEO metadata + calendar links (Vercel falls back to its production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3107
